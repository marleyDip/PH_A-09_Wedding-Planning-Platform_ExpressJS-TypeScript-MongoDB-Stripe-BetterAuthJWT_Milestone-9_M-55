# Application
NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Dhaka

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=wedding-planning-platform
USERS_COLLECTION=user
SESSIONS_COLLECTION=session

# Authentication
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=
PREMIUM_PRICE_AMOUNT=
PREMIUM_CURRENCY=usd


# ---------- server ----------
NODE_ENV=development
PORT=5000

# ---------- MongoDB (same database your Better Auth uses) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=wedding-planning-platform
# Better Auth's default collection names. Only change them if you changed them in auth.ts.
USERS_COLLECTION=user
SESSIONS_COLLECTION=session

# ---------- Better Auth ----------
# Base URL of the app that runs Better Auth (the Next.js site). Used to fetch the JWKS and as the
# expected JWT issuer + audience, so it must equal BETTER_AUTH_URL in auth.ts exactly.
BETTER_AUTH_URL=http://localhost:3000

# ---------- CORS / redirects ----------
# Allowed browser origins, comma separated. The FIRST one is used for Stripe success / cancel redirects.
CLIENT_URL=http://localhost:3000

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Use EITHER a recurring Price created in the Stripe dashboard ...
STRIPE_PREMIUM_PRICE_ID=
# ... OR set an amount in the smallest currency unit (e.g. 1999 = 19.99) and a currency.
PREMIUM_PRICE_AMOUNT=
PREMIUM_CURRENCY=usd

# ---------- misc ----------
# Used to decide what "today" is when validating event dates.
APP_TIMEZONE=Asia/Dhaka
